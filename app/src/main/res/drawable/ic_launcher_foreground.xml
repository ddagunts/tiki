<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ============================================================
         Outer kaleidoscope: 8 large leaf-petals radiating from center.
         Each petal is a curved almond that tapers at both ends.
         Colors rotate through a four-jewel palette in 2-fold mirror:
         Teal · Cyan · Violet · Magenta · Coral · Gold · Lime · Mint
         ============================================================ -->

    <!-- Petal 0 — top — Teal -->
    <group android:name="p0" android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FF7DD3C0"
                    android:endColor="#FF143A36"/>
            </aapt:attr>
        </path>
    </group>

    <!-- Petal 1 — 45° — Cyan -->
    <group android:name="p1" android:pivotX="54" android:pivotY="54" android:rotation="45">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FF00E5FF"
                    android:endColor="#FF003A44"/>
            </aapt:attr>
        </path>
    </group>

    <!-- Petal 2 — 90° — Violet -->
    <group android:name="p2" android:pivotX="54" android:pivotY="54" android:rotation="90">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FFB388FF"
                    android:endColor="#FF26104A"/>
            </aapt:attr>
        </path>
    </group>

    <!-- Petal 3 — 135° — Magenta -->
    <group android:name="p3" android:pivotX="54" android:pivotY="54" android:rotation="135">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FFFF4081"
                    android:endColor="#FF4A0E2A"/>
            </aapt:attr>
        </path>
    </group>

    <!-- Petal 4 — 180° — Coral -->
    <group android:name="p4" android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FFFF6B9D"
                    android:endColor="#FF4A1A2E"/>
            </aapt:attr>
        </path>
    </group>

    <!-- Petal 5 — 225° — Gold -->
    <group android:name="p5" android:pivotX="54" android:pivotY="54" android:rotation="225">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FFFFC107"
                    android:endColor="#FF4A3500"/>
            </aapt:attr>
        </path>
    </group>

    <!-- Petal 6 — 270° — Lime -->
    <group android:name="p6" android:pivotX="54" android:pivotY="54" android:rotation="270">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FF76FF03"
                    android:endColor="#FF1A3A00"/>
            </aapt:attr>
        </path>
    </group>

    <!-- Petal 7 — 315° — Mint -->
    <group android:name="p7" android:pivotX="54" android:pivotY="54" android:rotation="315">
        <path android:pathData="M54,54 Q40,30 54,4 Q68,30 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="4"
                    android:startColor="#FF50E3C2"
                    android:endColor="#FF103A30"/>
            </aapt:attr>
        </path>
    </group>

    <!-- ============================================================
         Inner ring: 8 smaller, brighter petals offset by 22.5°,
         creating a star-burst that interleaves with the outer ring.
         ============================================================ -->

    <group android:name="i0" android:pivotX="54" android:pivotY="54" android:rotation="22.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFFFF8E1"
                    android:endColor="#88FFC107"/>
            </aapt:attr>
        </path>
    </group>
    <group android:name="i1" android:pivotX="54" android:pivotY="54" android:rotation="67.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#88FF4081"/>
            </aapt:attr>
        </path>
    </group>
    <group android:name="i2" android:pivotX="54" android:pivotY="54" android:rotation="112.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFE0F7FA"
                    android:endColor="#8800E5FF"/>
            </aapt:attr>
        </path>
    </group>
    <group android:name="i3" android:pivotX="54" android:pivotY="54" android:rotation="157.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFF3E5F5"
                    android:endColor="#88B388FF"/>
            </aapt:attr>
        </path>
    </group>
    <group android:name="i4" android:pivotX="54" android:pivotY="54" android:rotation="202.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFFFF8E1"
                    android:endColor="#88FFC107"/>
            </aapt:attr>
        </path>
    </group>
    <group android:name="i5" android:pivotX="54" android:pivotY="54" android:rotation="247.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#88FF4081"/>
            </aapt:attr>
        </path>
    </group>
    <group android:name="i6" android:pivotX="54" android:pivotY="54" android:rotation="292.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFE0F7FA"
                    android:endColor="#8800E5FF"/>
            </aapt:attr>
        </path>
    </group>
    <group android:name="i7" android:pivotX="54" android:pivotY="54" android:rotation="337.5">
        <path android:pathData="M54,54 Q49,40 54,18 Q59,40 54,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="54" android:startY="54"
                    android:endX="54" android:endY="18"
                    android:startColor="#FFF3E5F5"
                    android:endColor="#88B388FF"/>
            </aapt:attr>
        </path>
    </group>

    <!-- ============================================================
         Faceted central medallion: dark octagon with a teal rim glow.
         Sits over the petal apexes so the key reads cleanly on top.
         ============================================================ -->

    <!-- Rim glow -->
    <path android:pathData="M54,54m-18,0a18,18 0 1,0 36,0a18,18 0 1,0 -36,0z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="18"
                android:startColor="#FF0B0D18"
                android:endColor="#447DD3C0"/>
        </aapt:attr>
    </path>

    <!-- Octagonal core -->
    <path android:fillColor="#FF06080F"
        android:pathData="M54,38 L65.3,42.7 L70,54 L65.3,65.3 L54,70 L42.7,65.3 L38,54 L42.7,42.7 Z"/>

    <!-- ============================================================
         The key — bright teal silhouette, centered in the medallion.
         Bow + shaft + two teeth, evenOdd fills the hole.
         ============================================================ -->
    <path
        android:fillType="evenOdd"
        android:pathData="
            M37,54
            a8,8 0 1,0 16,0
            a8,8 0 1,0 -16,0 Z
            M41.5,54
            a3.5,3.5 0 1,1 7,0
            a3.5,3.5 0 1,1 -7,0 Z
            M53,51
            L70,51
            L70,60
            L67,60
            L67,56
            L65,56
            L65,59
            L62,59
            L62,56
            L53,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="37" android:startY="46"
                android:endX="70" android:endY="62"
                android:startColor="#FFFFFFFF"
                android:endColor="#FF7DD3C0"/>
        </aapt:attr>
    </path>

    <!-- Tiny sparkle accent on the bow for a jewel highlight. -->
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M40,49 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0 Z"/>
</vector>
