<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Deep base: near-black with a faint blue tilt to make jewel tones pop. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108"
                android:startColor="#FF0B0D18"
                android:endColor="#FF02030A" />
        </aapt:attr>
    </path>

    <!-- Soft radial bloom behind the kaleidoscope core. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="60"
                android:startColor="#557DD3C0"
                android:endColor="#007DD3C0" />
        </aapt:attr>
    </path>

    <!-- 12 alternating prismatic wedges for an underlying kaleidoscope shimmer. -->
    <group android:name="wedgeA0" android:pivotX="54" android:pivotY="54" android:rotation="0">
        <path android:pathData="M54,54 L54,-10 L70,-10 Z" android:fillColor="#22FF4081"/>
    </group>
    <group android:name="wedgeA1" android:pivotX="54" android:pivotY="54" android:rotation="60">
        <path android:pathData="M54,54 L54,-10 L70,-10 Z" android:fillColor="#22FFC107"/>
    </group>
    <group android:name="wedgeA2" android:pivotX="54" android:pivotY="54" android:rotation="120">
        <path android:pathData="M54,54 L54,-10 L70,-10 Z" android:fillColor="#2200E5FF"/>
    </group>
    <group android:name="wedgeA3" android:pivotX="54" android:pivotY="54" android:rotation="180">
        <path android:pathData="M54,54 L54,-10 L70,-10 Z" android:fillColor="#22B388FF"/>
    </group>
    <group android:name="wedgeA4" android:pivotX="54" android:pivotY="54" android:rotation="240">
        <path android:pathData="M54,54 L54,-10 L70,-10 Z" android:fillColor="#2276FF03"/>
    </group>
    <group android:name="wedgeA5" android:pivotX="54" android:pivotY="54" android:rotation="300">
        <path android:pathData="M54,54 L54,-10 L70,-10 Z" android:fillColor="#22FF6B9D"/>
    </group>
</vector>
